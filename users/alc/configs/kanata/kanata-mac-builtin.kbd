;; Mac built-in keyboard remapping (US layout with Norwegian chars)
;; See ADR-0011

(defcfg
  process-unmapped-keys yes
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

(defvar
  tap-timeout 150
  hold-timeout 150
  tap-timeout-c 100
  hold-timeout-c 100
)

(defalias
  ;; Caps Lock: tap = Escape, hold = Left Control
  ce (tap-hold $tap-timeout $hold-timeout esc lctrl)

  ;; Tab: tap = Tab, hold = Left Alt/Option
  ta (tap-hold $tap-timeout $hold-timeout tab lalt)

  ;; Backtick: tap = `, hold = nav layer (same as Glove80)
  `_nav (tap-hold $tap-timeout-c $hold-timeout-c ` (layer-toggle nav))

  ;; ISO < key (between left shift and z): same nav layer trigger
  ;; On Norwegian layout this key is < — same physical position as ` on US ANSI
  <_nav (tap-hold $tap-timeout-c $hold-timeout-c lsgt (layer-toggle nav))

  ;; Home row mods — left hand
  ha (tap-hold $tap-timeout $hold-timeout a (multi lctrl lsft lmeta lalt))  ;; Hyper
  hs (tap-hold $tap-timeout $hold-timeout s lalt)
  hd (tap-hold $tap-timeout $hold-timeout d lctrl)
  hf (tap-hold $tap-timeout $hold-timeout f lsft)

  ;; Home row mods — right hand (mirrored)
  hj (tap-hold $tap-timeout $hold-timeout j rsft)
  hk (tap-hold $tap-timeout $hold-timeout k rctrl)
  hl (tap-hold $tap-timeout $hold-timeout l ralt)
  h; (tap-hold $tap-timeout $hold-timeout ; (multi rctrl rsft rmeta ralt))  ;; Hyper

  ;; Accented characters (shift-aware)
  ea (fork (unicode é) (unicode É) (lsft rsft))
  oa (fork (unicode ø) (unicode Ø) (lsft rsft))
  aa (fork (unicode æ) (unicode Æ) (lsft rsft))
  aaa (fork (unicode å) (unicode Å) (lsft rsft))
)

(defsrc
  `    tab  caps lsgt
  a    s    d    f    h    j    k    l    ;
  e    -    '
)

(deflayer base
  @`_nav @ta  @ce  @<_nav
  @ha  @hs  @hd  @hf  h    @hj  @hk  @hl  @h;
  e    -    '
)

;; Navigation layer (activated by holding backtick or ISO < key)
;; Matches Glove80 layout: hjkl=arrows, Norwegian chars on e/-/'/;
(deflayer nav
  _    _    _    _
  _    _    _    _    left down up   right @aaa
  @ea  @oa  @aa
)
