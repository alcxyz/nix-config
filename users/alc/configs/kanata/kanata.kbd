;; Define timeout values
(defvar
  tap-timeout 150
  hold-timeout 150
  tap-timeout-c 100
  hold-timeout-c 100
)

;; Define custom aliases for tap-hold behaviors
(defalias
  ;; Tab as Control when held
  tc (tap-hold $tap-timeout $hold-timeout tab lctrl)

  ;; Caps as Escape when tapped, Super when held
  ce (tap-hold $tap-timeout $hold-timeout esc lmeta)

  ;; Left Alt as Backspace when tapped
  lab (tap-hold $tap-timeout $hold-timeout bspc lalt)

  ;; Left Meta/Cmd as Backspace when tapped
  lcb (tap-hold $tap-timeout $hold-timeout bspc lmeta)

  ;; Right Alt as Enter when tapped
  rae (tap-hold $tap-timeout $hold-timeout ret ralt)

  ;; Right Meta/Cmd as Enter when tapped
  rce (tap-hold $tap-timeout $hold-timeout ret rmeta)

  ;; ` as ` when tapped, activate nav layer when held
  `_nav (tap-hold $tap-timeout-c $hold-timeout-c ` (layer-toggle nav))

  ;; Accented characters (shift-aware)
  ea (fork (unicode é) (unicode É) (lsft rsft))
  oa (fork (unicode ø) (unicode Ø) (lsft rsft))
  aa (fork (unicode æ) (unicode Æ) (lsft rsft))
  aaa (fork (unicode å) (unicode Å) (lsft rsft))
)

;; Define base layer source keys
(defsrc
  tab  caps lalt lmeta ralt rmeta
  ` h j k l e - ' ;
)

;; Define the main layer
(deflayer base
  @tc   @ce   @lab  @lcb  @rae  @rce
  @`_nav h j k l e - ' ;
)

;; Define the navigation layer
(deflayer nav
  _    _    _    _    _    _
  _ left down up right @ea @oa @aa @aaa
)
