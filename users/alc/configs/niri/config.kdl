// ============================================================
// NIRI CONFIGURATION
// ============================================================
//
// Keybinding philosophy (matches Hyprland setup):
//   Mod alone:     Focus / Navigate (read-only movement)
//   Mod+Shift:     Move / Transfer (relocating things)
//   Mod+Ctrl:      Fine control / extremes
//   Mod+Alt:       Resize / Adjust properties
//   Alt alone:     Quick access (apps, launchers)

// ==================== INPUT ====================

input {
    keyboard {
        xkb {
            layout "us,no"
            options "grp:alt_shift_toggle"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {}
}

// ==================== OUTPUT ====================

output "DP-1" {
    mode "5120x1440@240"
    position x=0 y=0
}

// Disable unused ports (adjust name if needed)
// output "HDMI-A-3" {
//     off
// }

// ==================== LAYOUT ====================

layout {
    gaps 2
    center-focused-column "never"

    // Column width presets — matches Hyprland explicit_column_widths
    preset-column-widths {
        proportion 0.166
        proportion 0.25
        proportion 0.333
        proportion 0.5
        proportion 0.666
        proportion 1.0
    }

    default-column-width { proportion 0.333; }

    focus-ring {
        width 2
        // TODO: integrate nix-colors for these values
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}

// ==================== APPEARANCE ====================

prefer-no-csd

// ==================== STARTUP ====================

spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "dms" "run"

// ==================== MISC ====================

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Niri default animations — remove this block or add "off" to disable
}

// ==================== WORKSPACES ====================

workspace "scratch"

// ==================== WINDOW RULES ====================

window-rule {
    match app-id=r#"^foot$"#
    opacity 0.98
}

window-rule {
    match app-id=r#"^dropterm$"#
    open-floating true
    opacity 0.9
}

window-rule {
    match app-id=r#"^scratchpad-term$"#
    open-floating true
    opacity 0.9
}

window-rule {
    match app-id=r#"^scratchpad-browser$"#
    open-floating true
}

// ==================== BINDINGS ====================

binds {

    // === HELP & SESSION ===
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+Escape { quit; }
    Mod+Q { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Backspace { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Space { spawn "dms" "ipc" "call" "spotlight" "toggle"; }

    // === QUICK ACCESS (Alt prefix) ===
    Alt+Return { spawn "foot"; }
    Alt+S { spawn "dms" "ipc" "call" "spotlight" "toggle"; }

    // === APPLICATIONS ===
    Mod+B { spawn "zen" "--no-remote" "-profile" "/home/alc/.zen/alcxyz"; }
    Mod+V { spawn "zen" "--no-remote" "-profile" "/home/alc/.zen/media"; }
    Mod+X { spawn "zen" "--no-remote" "-profile" "/home/alc/.zen/xyz"; }
    Mod+G { spawn "thunderbird"; }
    Mod+F { spawn "nautilus"; }

    // === WINDOW MANAGEMENT ===
    Mod+W { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+Return { fullscreen-window; }
    Mod+O { toggle-overview; }

    // === PRIMARY NAVIGATION (Mod alone) ===
    // Horizontal: columns
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }

    // Vertical: workspaces
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Up { focus-workspace-up; }

    // Workspace switching
    Mod+Tab { focus-workspace-previous; }
    Alt+Tab { focus-window-down; }

    // === PRIMARY MOVE (Mod+Shift) ===
    // Horizontal column movement
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // Vertical workspace transfers
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }

    // === FINE CONTROL / EXTREMES (Mod+Ctrl) ===
    // Viewport positioning (niri equivalents of Hyprland fit commands)
    Mod+Ctrl+N { focus-column-first; }
    Mod+Ctrl+M { center-column; }
    Mod+Ctrl+Comma { expand-column-to-available-width; }
    Mod+Ctrl+Period { maximize-column; }

    // Window manipulation within column
    Mod+Ctrl+J { focus-window-down; }
    Mod+Ctrl+K { focus-window-up; }

    // Consume / Expel — structural column changes (niri-native)
    Mod+Ctrl+Y { consume-window-into-column; }
    Mod+Ctrl+U { expel-window-from-column; }

    // === COLUMN WIDTH PRESETS (Mod alone, comma/period) ===
    Mod+Comma { switch-preset-column-width-back; }
    Mod+Period { switch-preset-column-width; }

    // === RESIZE / ADJUST (Mod+Alt) ===
    Mod+Alt+H { set-column-width "-5%"; }
    Mod+Alt+L { set-column-width "+5%"; }
    Mod+Alt+Left { set-column-width "-5%"; }
    Mod+Alt+Right { set-column-width "+5%"; }

    // === WORKSPACE DIRECT ACCESS (Mod+number) ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // === MOVE TO NUMBERED WORKSPACES (Mod+Ctrl+number) ===
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // === F-KEYS (double-tap: workspace / scratch toggle) ===
    F1 { spawn-sh "~/.config/niri/scripts/fkey-handler.sh F1 1"; }
    F2 { spawn-sh "~/.config/niri/scripts/fkey-handler.sh F2 2"; }
    F3 { spawn-sh "~/.config/niri/scripts/fkey-handler.sh F3 3"; }
    F4 { spawn-sh "~/.config/niri/scripts/fkey-handler.sh F4 4"; }
    F5 { spawn-sh "~/.config/niri/scripts/fkey-handler.sh F5 5"; }
    F6 { spawn-sh "~/.config/niri/scripts/fkey-handler.sh F6 6"; }

    // === SCRATCHPAD ===
    // Dropdown terminal (ndrop toggles by app-id, like hyprscratch on Hyprland)
    Alt+Space { spawn-sh "ndrop -c dropterm foot -w 2400x1400 --app-id dropterm --title dropterm"; }
    // Toggle scratch workspace
    Mod+Escape { spawn-sh "~/.config/niri/scripts/scratch-toggle.sh"; }
    // Move window to scratch workspace
    Mod+Alt+Escape { move-column-to-workspace "scratch"; }

    // === SILENT MOVE VARIANTS (Mod+Alt) ===
    // Niri does not have "silent" moves — these use regular move semantics
    Mod+Alt+J { move-column-to-workspace-down; }
    Mod+Alt+K { move-column-to-workspace-up; }
    Mod+Alt+Down { move-column-to-workspace-down; }
    Mod+Alt+Up { move-column-to-workspace-up; }

    Mod+Alt+1 { move-column-to-workspace 1; }
    Mod+Alt+2 { move-column-to-workspace 2; }
    Mod+Alt+3 { move-column-to-workspace 3; }
    Mod+Alt+4 { move-column-to-workspace 4; }
    Mod+Alt+5 { move-column-to-workspace 5; }
    Mod+Alt+6 { move-column-to-workspace 6; }
    Mod+Alt+7 { move-column-to-workspace 7; }
    Mod+Alt+8 { move-column-to-workspace 8; }
    Mod+Alt+9 { move-column-to-workspace 9; }
    Mod+Alt+0 { move-column-to-workspace 10; }

    // === SYSTEM ACTIONS (DMS) ===
    Mod+Shift+N { spawn "dms" "ipc" "call" "notifications" "open"; }
    Mod+Shift+C { spawn "dms" "ipc" "call" "wallpaper" "next"; }
    Mod+Shift+R { spawn "dms" "ipc" "call" "bar" "toggle" "index" "0"; }
    Mod+N { spawn "dms" "ipc" "call" "notepad" "toggle"; }

    // === MEDIA CONTROLS (DMS audio) ===
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    F10 { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    F9  { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    F8  { spawn "dms" "ipc" "call" "audio" "mute"; }

    // === SCREENSHOTS ===
    Mod+Shift+4 { spawn "dms" "screenshot"; }

    // === MOUSE INTEGRATION ===
    // Column navigation (Mod alone)
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }

    // Workspace navigation (Mod+Ctrl)
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

    // Column width resize (Mod+Alt)
    Mod+Alt+WheelScrollUp   cooldown-ms=150 { set-column-width "-5%"; }
    Mod+Alt+WheelScrollDown cooldown-ms=150 { set-column-width "+5%"; }

    // Move column to workspace (Mod+Shift)
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
}
