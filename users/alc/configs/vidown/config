# Public fallback config for the vidown TUI and CLI.
# Private browser profiles and ignored hosts live in nix-secrets.
output_dir = "/tank/stash/vidown"
chronological_output = false
max_per_fqdn = 3
bulk_download_limit = 3
skip_successful_history = true
skip_handled_browser_tabs = false
skip_failed_history = true
failed_history_retry_after = "24h"
detect_bulk_downloads = true
ignored_hosts = ""
browser_tab_filter = "video"
browser_firefox_profiles = ""
browser_firefox_roots = "~/.mozilla/firefox,~/.zen"
browser_devtools_urls = ""
browser_chromium_profiles = ""
