# Runtime output for the vidown TUI and CLI.
output_dir = "~/Videos/vidown"
max_per_fqdn = 3
skip_successful_history = true
skip_handled_browser_tabs = false
ignored_hosts = "google.com,duckduckgo.com"
browser_tab_filter = "video"
browser_firefox_profiles = "~/.zen/xyz"
browser_devtools_urls = "helium:asdf=http://127.0.0.1:9222/json,brave:abc=http://127.0.0.1:9223/json"
browser_chromium_profiles = "helium:asdf=~/.config/net.imput.helium/Profile 1,brave:abc=~/.config/BraveSoftware/Brave-Browser/Profile 1"
