diff --git a/buildcatrust/tests/test_omit_blocklisted.py b/buildcatrust/tests/test_omit_blocklisted.py
new file mode 100644
--- /dev/null
+++ b/buildcatrust/tests/test_omit_blocklisted.py
@@ -0,0 +1,29 @@
+from buildcatrust import cli
+from . import helpers
+
+
+def test_omit_blocklisted(tmp_path):
+    outputs = {
+        "ca_bundle_output": tmp_path / "bundle.crt",
+        "ca_standard_bundle_output": tmp_path / "plain.crt",
+        "p11kit_output": tmp_path / "trust.p11-kit",
+        "ca_unpacked_output": tmp_path / "unbundled",
+        "ca_hashed_unpacked_output": tmp_path / "hashed",
+    }
+    for name in ("ca_unpacked_output", "ca_hashed_unpacked_output"):
+        outputs[name].mkdir()
+    args = [
+        "--omit-blocklisted",
+        "--certdata_input",
+        str(helpers.TESTDATA_DIR / "certdata-certumec384.txt"),
+        "--blocklist_input",
+        str(helpers.TESTDATA_DIR / "blocklist-certumec384.txt"),
+    ]
+    args.extend(f"--{name}={path}" for name, path in outputs.items())
+    assert cli.cli_main(args) == 0
+    for name, path in outputs.items():
+        if name in ("ca_unpacked_output", "ca_hashed_unpacked_output"):
+            assert not list(path.iterdir())
+        else:
+            assert path.read_text() == ""
+
