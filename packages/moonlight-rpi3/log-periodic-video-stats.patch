             Session::get()->getOverlayManager().setOverlayTextUpdated(Overlay::OverlayDebug);
         }
 
+        const char* statsLogIntervalValue = SDL_getenv("MOONLIGHT_VIDEO_STATS_LOG_INTERVAL_MS");
+        int statsLogInterval = statsLogIntervalValue != nullptr ? SDL_atoi(statsLogIntervalValue) : 0;
+        if (statsLogInterval > 0 &&
+                (m_LastVideoStatsLogTimestamp == 0 ||
+                 SDL_TICKS_PASSED(SDL_GetTicks(), m_LastVideoStatsLogTimestamp + statsLogInterval))) {
+            logVideoStats(lastTwoWndStats, "Rolling video stats");
+            m_LastVideoStatsLogTimestamp = SDL_GetTicks();
