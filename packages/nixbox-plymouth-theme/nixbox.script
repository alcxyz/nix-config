# NIXBOX media-center boot and shutdown theme.

fun clamp(value)
  {
    if (value < 0)
      return 0;
    if (value > 1)
      return 1;
    return value;
  }

fun smooth(value)
  {
    value = clamp(value);
    return value * value * (3 - 2 * value);
  }

fun ease_out(value)
  {
    value = clamp(value);
    inverse = 1 - value;
    return 1 - inverse * inverse * inverse;
  }

fun setup_letter(index, filename)
  {
    local.original = Image(filename);
    global.letters[index].image = local.original.Scale(
      Math.Int(104 * global.layout_scale),
      Math.Int(106 * global.layout_scale)
    );
    global.letters[index].sprite = Sprite(global.letters[index].image);
    global.letters[index].final_x = global.word_x + index * global.slot_width;
    global.letters[index].sprite.SetPosition(
      global.letters[index].final_x,
      global.word_y,
      20
    );
  }

Window.SetBackgroundTopColor(0.043, 0.047, 0.059);
Window.SetBackgroundBottomColor(0.043, 0.047, 0.059);
Plymouth.SetRefreshRate(60);

global.mode = Plymouth.GetMode();
global.shutdown = global.mode == "shutdown" || global.mode == "reboot";
global.frame = 0;
global.boot_progress = 0;
global.visual_progress = 0;

# A KMS handoff changes Plymouth's virtual canvas. Rebuild every scaled sprite
# against the new bounds so the same centered composition appears on every
# pixel display instead of retaining the transient framebuffer geometry.
fun setup_layout()
  {
    global.layout_scale = Window.GetWidth() / 1920;
    local.height_scale = Window.GetHeight() / 1080;
    if (local.height_scale < global.layout_scale)
      global.layout_scale = local.height_scale;

    global.slot_width = 104 * global.layout_scale;
    global.word_width = 624 * global.layout_scale;
    global.word_x = Window.GetX() + Window.GetWidth() / 2 - global.word_width / 2;
    global.word_y = Window.GetY() + Window.GetHeight() / 2 - 116 * global.layout_scale;
    global.word_center_x = Window.GetX() + Window.GetWidth() / 2 - 52 * global.layout_scale;

    setup_letter(0, "letter-N.png");
    setup_letter(1, "letter-I.png");
    setup_letter(2, "letter-X.png");
    setup_letter(3, "letter-B.png");
    setup_letter(4, "letter-O.png");
    setup_letter(5, "letter-X.png");

    watermark.original = Image("nix-snowflake-white.png");
    watermark.size = Math.Int(Window.GetWidth() * 0.58);
    watermark.image = watermark.original.Scale(watermark.size, watermark.size);
    watermark.sprite = Sprite(watermark.image);
    watermark.sprite.SetPosition(
      Window.GetX() + Window.GetWidth() / 2 - watermark.size / 2,
      Window.GetY() + Window.GetHeight() / 2 - watermark.size / 2,
      10
    );

    if (global.shutdown)
      subtitle.original = Image("subtitle-powering-off.png");
    else
      subtitle.original = Image("subtitle-media-center.png");
    subtitle.width = Math.Int(600 * global.layout_scale);
    subtitle.height = Math.Int(36 * global.layout_scale);
    subtitle.image = subtitle.original.Scale(subtitle.width, subtitle.height);
    subtitle.sprite = Sprite(subtitle.image);
    subtitle.sprite.SetPosition(
      Window.GetX() + Window.GetWidth() / 2 - subtitle.width / 2,
      Window.GetY() + Window.GetHeight() / 2 + 44 * global.layout_scale,
      20
    );

    progress_track.original = Image("progress-track.png");
    progress_track.width = Math.Int(520 * global.layout_scale);
    progress_track.height = Math.Int(3 * global.layout_scale);
    if (progress_track.height < 1)
      progress_track.height = 1;
    progress_track.image = progress_track.original.Scale(
      progress_track.width,
      progress_track.height
    );
    progress_track.sprite = Sprite(progress_track.image);
    progress_track.x = Window.GetX() + Window.GetWidth() / 2 - progress_track.width / 2;
    progress_track.y = Window.GetY() + Window.GetHeight() / 2 + 112 * global.layout_scale;
    progress_track.sprite.SetPosition(progress_track.x, progress_track.y, 20);

    progress_fill.original = Image("progress-fill.png");
    progress_fill.sprite = Sprite();
    progress_fill.sprite.SetPosition(progress_track.x, progress_track.y, 21);

    if (global.shutdown)
      {
        watermark.sprite.SetOpacity(0.05);
        subtitle.sprite.SetOpacity(1);
        progress_track.sprite.SetOpacity(0);
        progress_fill.sprite.SetOpacity(0);
        for (index = 0; index < 6; index++)
          global.letters[index].sprite.SetOpacity(1);
      }
    else
      {
        watermark.sprite.SetOpacity(0);
        subtitle.sprite.SetOpacity(0);
        progress_track.sprite.SetOpacity(0);
        progress_fill.sprite.SetOpacity(0);
        for (index = 0; index < 6; index++)
          global.letters[index].sprite.SetOpacity(0);
        global.letters[2].sprite.SetX(global.word_center_x);
        global.letters[5].sprite.SetX(global.word_center_x);
      }
  }

setup_layout();

# The firmware framebuffer is replaced by i915 and dock-backed pixel displays
# shortly after Plymouth starts. Rebuild the composition for each new canvas;
# the XPS boot sequencer reloads the theme once output discovery has settled,
# which gives the visible display a deliberate frame-zero start.
fun display_hotplug_callback()
  {
    setup_layout();
  }

Plymouth.SetDisplayHotplugFunction(display_hotplug_callback);

fun boot_progress_callback(duration, progress)
  {
    local.progress = clamp(progress);
    if (local.progress > global.boot_progress)
      global.boot_progress = local.progress;
  }

Plymouth.SetBootProgressFunction(boot_progress_callback);

fun refresh_callback()
  {
    global.frame += 1;
    local.time = global.frame / 60;

    if (global.shutdown)
      {
        local.watermark_fade = clamp((local.time - 0.6) / 1.8);
        watermark.sprite.SetOpacity(0.05 * (1 - local.watermark_fade * local.watermark_fade * local.watermark_fade));

        local.subtitle_fade = clamp((local.time - 1.2) / 0.8);
        subtitle.sprite.SetOpacity(1 - local.subtitle_fade * local.subtitle_fade * local.subtitle_fade);

        local.fade = clamp((local.time - 0.7) / 0.5);
        global.letters[0].sprite.SetOpacity(1 - local.fade * local.fade * local.fade);
        local.fade = clamp((local.time - 0.8) / 0.5);
        global.letters[1].sprite.SetOpacity(1 - local.fade * local.fade * local.fade);
        local.fade = clamp((local.time - 0.9) / 0.5);
        global.letters[3].sprite.SetOpacity(1 - local.fade * local.fade * local.fade);
        local.fade = clamp((local.time - 1.0) / 0.5);
        global.letters[4].sprite.SetOpacity(1 - local.fade * local.fade * local.fade);

        local.travel = smooth((local.time - 1.7) / 1.1);
        global.letters[2].sprite.SetX(
          global.letters[2].final_x + (global.word_center_x - global.letters[2].final_x) * local.travel
        );
        global.letters[5].sprite.SetX(
          global.letters[5].final_x + (global.word_center_x - global.letters[5].final_x) * local.travel
        );
        local.x_fade = clamp((local.time - 3.0) / 0.6);
        global.letters[2].sprite.SetOpacity(1 - local.x_fade * local.x_fade * local.x_fade);
        global.letters[5].sprite.SetOpacity(1 - local.x_fade * local.x_fade * local.x_fade);

        local.black = clamp((local.time - 3.0) / 1.0);
        local.background = 0.043 * (1 - local.black * local.black * local.black);
        Window.SetBackgroundTopColor(local.background, local.background, local.background);
        Window.SetBackgroundBottomColor(local.background, local.background, local.background);
      }
    else
      {
        local.x_opacity = ease_out((local.time - 0.1) / 0.5);
        global.letters[2].sprite.SetOpacity(local.x_opacity);
        global.letters[5].sprite.SetOpacity(local.x_opacity);

        local.travel = smooth((local.time - 0.9) / 1.3);
        global.letters[2].sprite.SetX(
          global.word_center_x + (global.letters[2].final_x - global.word_center_x) * local.travel
        );
        global.letters[5].sprite.SetX(
          global.word_center_x + (global.letters[5].final_x - global.word_center_x) * local.travel
        );

        global.letters[0].sprite.SetOpacity(ease_out((local.time - 2.30) / 0.7));
        global.letters[1].sprite.SetOpacity(ease_out((local.time - 2.42) / 0.7));
        global.letters[3].sprite.SetOpacity(ease_out((local.time - 2.54) / 0.7));
        global.letters[4].sprite.SetOpacity(ease_out((local.time - 2.66) / 0.7));
        subtitle.sprite.SetOpacity(ease_out((local.time - 3.0) / 1.0));
        progress_track.sprite.SetOpacity(ease_out((local.time - 3.5) / 0.8));

        # Prefer Plymouth's measured boot estimate when it is available. The
        # Fable prototype supplies the visual fallback so a missing timing
        # cache cannot leave the final lockup with an empty bar.
        local.prototype_progress = ease_out((local.time - 3.7) / 4.0);
        local.progress_target = global.boot_progress;
        if (local.prototype_progress > local.progress_target)
          local.progress_target = local.prototype_progress;
        if (local.progress_target > global.visual_progress)
          global.visual_progress = local.progress_target;

        local.watermark_progress = clamp((global.visual_progress - 0.2) / 0.62);
        watermark.sprite.SetOpacity(0.05 * local.watermark_progress);

        local.fill_width = Math.Int(progress_track.width * global.visual_progress);
        if (local.fill_width > 0)
          {
            local.fill_image = progress_fill.original.Scale(local.fill_width, progress_track.height);
            progress_fill.sprite.SetImage(local.fill_image);
            progress_fill.sprite.SetOpacity(progress_track.sprite.GetOpacity());
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

# Plymouth only renders one frame after invoking the quit callback. Use that
# frame as the completed handoff state; Hyprland then starts the matching
# Quickshell outro from exactly the same composition.
fun quit_callback()
  {
    if (!global.shutdown)
      {
        watermark.sprite.SetOpacity(0.05);
        subtitle.sprite.SetOpacity(1);
        progress_track.sprite.SetOpacity(1);

        for (index = 0; index < 6; index++)
          {
            global.letters[index].sprite.SetX(global.letters[index].final_x);
            global.letters[index].sprite.SetOpacity(1);
          }

        local.fill_image = progress_fill.original.Scale(
          progress_track.width,
          progress_track.height
        );
        progress_fill.sprite.SetImage(local.fill_image);
        progress_fill.sprite.SetOpacity(1);
      }
  }

Plymouth.SetQuitFunction(quit_callback);

# Keep password prompts usable if an encrypted or recovery path needs them.
fun display_password_callback(prompt, bullets)
  {
    local.message = Image.Text(prompt, 0.91, 0.93, 0.96);
    global.password_sprite = Sprite(local.message);
    global.password_sprite.SetPosition(
      Window.GetX() + Window.GetWidth() / 2 - local.message.GetWidth() / 2,
      Window.GetY() + Window.GetHeight() * 0.72,
      100
    );
  }

fun display_normal_callback()
  {
    if (global.password_sprite)
      global.password_sprite.SetOpacity(0);
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
