* {
  all: unset;
  font-family: JetBrains Mono Nerd Font;
}

window {
  background-color: #@base00@;
}

button {
  color: #@base01@;
  font-size: 64px;
  background-color: rgba(0,0,0,0);
  outline-style: none;
  margin: 5px;
}

button:focus, button:active, button:hover {
  color: #@base0d@;
  transition: ease 0.4s;
}
