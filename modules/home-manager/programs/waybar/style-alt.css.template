* {
    border: none;
    border-radius: 10px;
    font-family: "JetBrainsMono Nerd Font";
    font-weight: bold;
    font-size: 12px;
    min-height: 0;
}

window#waybar {
    background: rgba(21, 18, 27, 0);
    color: #@base05@;
}

tooltip {
    background: #@base00@;
    border-radius: 7px;
    border-width: 2.5px;
    border-style: solid;
    border-color: #@base0d@;
    padding-right: 5px;
    padding-left: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
}

#workspaces button {
    color: #@base02@;
    margin-right: 5px;
    padding-right: 0px;
    padding-left: 0px;
}

#workspaces button.active {
    color: #@base0d@;
}

#workspaces button.focused {
    color: #@base04@;
    background: #@base08@;
    border-radius: 13px;
}

#workspaces button.persistent {
    color: #@base0a@;
}

#workspaces button.empty {
    color: #@base02@;
}

#workspaces button.active,
#workspaces button.visible {
    color: #@base0d@;
    box-shadow: inset 0 -1px #@base00@;
}

#workspaces button.urgent {
    color: #@base08@;
}

#custom-weather,
#language,
#cpu,
#window,
#clock,
#pulseaudio,
#pulseaudio.microphone,
#workspaces,
#tray,
#memory,
#disk,
#tray {
    background: #@base00@;
    opacity: 1.0;
    padding: 1.5px 7px 1.5px 7px;
    margin-top: 5px;
    margin-bottom: 5px;
    border-radius: 13px;
    margin-right: 5px;
    margin-left: 5px;
}

#workspaces {
    background: #@base00@;
    border-radius: 13px;
    margin-left: 5px;
    padding-right: 0px;
}

#window {
    border-radius: 7px;
    margin-left: 60px;
    margin-right: 60px;
}

#clock {
    color: #@base0b@;
    border-radius: 0px 13px 13px 0px;
    margin-right: 0px;
    margin-left: 0px;
}

#network {
    color: #@base0a@;
    border-radius: 7px 7px 7px 7px;
    margin-right: 5px;
}

#custom-notifications {
    color: #@base0a@;
    border-radius: 7px 7px 7px 7px;
    padding-left: 9px;
    padding-right: 15px;
    margin-left:  2px;
    margin-right: 2px;
}

#custom-updates {
    color: #@base0d@;
    border-radius: 7px 7px 7px 7px;
    border-left:  0px;
    border-right: 0px;
    margin-left:  2px;
    margin-right: 2px;
}

#custom-player {
    color: #@base0e@;
    border-radius: 7px 7px 7px 7px;
    padding-left: 4px;
    margin-left:  5px;
    margin-right: 5px;
}

#memory {
    color: #@base0d@;
    border-radius: 0px 0px 0px 0px;
    margin-left: 0px;
    margin-right:0px;
}

#disk {
    color: #@base0a@;
    border-radius: 0px 13px 13px 0px;
    margin-left: 0px;
}

#bluetooth {
    color: #@base0d@;
    border-radius: 0px 13px 13px 0px;
    margin-left: 5px;
    margin-right: 5px;
} 

#pulseaudio {
    color: #@base0d@;
    border-radius: 0px 0px 0px 0px;
    margin-right: 0px;
    margin-left: 0px;
}

#pulseaudio.microphone {
    color: #@base0e@;
    border-radius: 0px 0px 0px 0px;
    margin-left: 0px;
    margin-right: 0px;
}

#language {
    border-radius: 13px 0px 0px 13px;
    margin-right:0px;
}

#cpu {
    border-radius: 13px 0px 0px 13px;
    padding-left:10px;
    margin-right:0px;
    margin-left: 0px;
}

#custom-weather {
    border-radius: 13px 13px 13px 13px;
    margin-right: 0px;
}
