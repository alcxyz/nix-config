+    function refreshRuntimeConfigProvider() {
+        if (!CompositorService.isHyprland) {
+            runtimeConfigProvider = "";
+            runtimeConfigProviderLoading = false;
+            return;
+        }
+        if (runtimeConfigProviderLoading)
+            return;
+
+        runtimeConfigProviderLoading = true;
+        Proc.runCommand("hypr-runtime-config-provider", ["hyprctl", "status", "-j"], (output, exitCode) => {
+            runtimeConfigProviderLoading = false;
+            let provider = "";
+            if (exitCode === 0) {
+                try {
+                    const status = JSON.parse(output.trim());
+                    provider = status.configProvider ?? "";
+                } catch (e) {
+                    log.warn("Failed to parse the active Hyprland config provider:", e);
+                }
+            }
+
+            runtimeConfigProvider = provider;
+            const pending = pendingRuntimeDispatches;
+            pendingRuntimeDispatches = [];
+            if (provider !== "lua" && provider !== "hyprlang") {
+                if (pending.length > 0)
+                    log.warn("Could not determine the active Hyprland config provider; discarding", pending.length, "deferred dispatches");
+                return;
+            }
+
+            for (const request of pending)
+                Hyprland.dispatch(provider === "lua" ? request.luaCommand : request.legacyCommand);
+        });
+    }
+
+    function dispatchForRuntimeProvider(luaCommand, legacyCommand) {
+        if (runtimeConfigProvider === "lua") {
+            Hyprland.dispatch(luaCommand);
+            return;
+        }
+        if (runtimeConfigProvider === "hyprlang") {
+            Hyprland.dispatch(legacyCommand);
+            return;
+        }
+
+        pendingRuntimeDispatches = pendingRuntimeDispatches.concat([{
+            luaCommand,
+            legacyCommand
+        }]);
+        refreshRuntimeConfigProvider();
+    }
+
