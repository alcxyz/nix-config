+func activeHyprlandConfigIsLua() bool {
+	output, err := exec.Command("hyprctl", "status", "-j").Output()
+	if err != nil {
+		return false
+	}
+	var status struct {
+		ConfigProvider string `json:"configProvider"`
+	}
+	if err := json.Unmarshal(output, &status); err != nil {
+		return false
+	}
+	return status.ConfigProvider == "lua"
+}
