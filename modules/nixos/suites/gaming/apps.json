{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin:$(HOME)/.nix-profile/bin"
  },
  "apps": [
    {
      "name": "Steam Gaming",
      "output": "",
      "cmd": [
        "sh", "-c", 
        "hyprctl dispatch workspace 9 && prepare-streaming-audio && gamescope-steam"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    },
    {
      "name": "Retro Gaming (EmulationStation)",
      "output": "",
      "cmd": [
        "sh", "-c", 
        "hyprctl dispatch workspace 9 && prepare-streaming-audio && gamescope-emulationstation"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    },
    {
      "name": "Browser Gaming",
      "output": "",
      "cmd": [
        "sh", "-c", 
        "hyprctl dispatch workspace 9 && prepare-streaming-audio && gamescope-browser"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    },
    {
      "name": "Desktop",
      "output": "",
      "cmd": [
        "sh", "-c",
        "restore-default-audio && hyprctl dispatch workspace 1"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    }
  ]
}
