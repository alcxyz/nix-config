{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png",
      "prep-cmd": [
        {
          "do": "restore-default-audio && hyprctl dispatch workspace 1"
        }
      ]
    },
    {
      "name": "Steam Gaming",
      "detached": [
        "sh -c 'hyprctl dispatch workspace 9 && prepare-streaming-audio && gamescope-steam'"
      ],
      "image-path": "steam.png"
    },
    {
      "name": "Retro Gaming", 
      "detached": [
        "sh -c 'hyprctl dispatch workspace 9 && prepare-streaming-audio && gamescope-emulationstation'"
      ],
      "image-path": "gamepad.png"
    },
    {
      "name": "Browser Gaming",
      "detached": [
        "sh -c 'hyprctl dispatch workspace 9 && prepare-streaming-audio && gamescope-browser'"
      ],
      "image-path": "browser.png"
    }
  ]
}
