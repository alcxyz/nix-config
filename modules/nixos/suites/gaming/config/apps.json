{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin:$(HOME)/.nix-profile/bin"
  },
  "apps": [
    {
      "name": "Steam",
      "output": "",
      "cmd": [
        "sh", "-c", 
        "gamescope-steam"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    },
    {
      "name": "Retro (ES-DE)",
      "output": "",
      "cmd": [
        "sh", "-c", 
        "gamescope-emulationstation"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    },
    {
      "name": "Browser",
      "output": "",
      "cmd": [
        "sh", "-c", 
        "gamescope-browser"
      ],
      "exclude-global-prep-cmd": false,
      "elevated": false,
      "auto-detach": true,
      "wait-all": false,
      "exit-timeout": 5
    },
  ]
}
