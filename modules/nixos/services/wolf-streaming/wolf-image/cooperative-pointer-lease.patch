   immer::atom<enet_clients_map> connected_clients;
 
+  const auto cooperative_pointer_lease = std::chrono::milliseconds(
+      std::stoull(utils::get_env("WOLF_COOPERATIVE_POINTER_LEASE_MS", "750")));
+  struct PointerLease {
+    std::size_t owner_session_id;
+    std::chrono::steady_clock::time_point expires_at;
+    std::set<unsigned char> pressed_buttons;
+  };
+  auto pointer_lease_mutex = std::make_shared<std::mutex>();
+  auto pointer_leases = std::make_shared<std::unordered_map<std::string, PointerLease>>();
+
+  auto is_pointer_packet = [](INPUT_TYPE type) {
+    switch (type) {
+    case MOUSE_MOVE_REL:
+    case MOUSE_MOVE_ABS:
+    case MOUSE_BUTTON_PRESS:
+    case MOUSE_BUTTON_RELEASE:
+    case MOUSE_SCROLL:
+    case MOUSE_HSCROLL:
+      return true;
+    default:
+      return false;
+    }
+  };
+
+  auto should_forward_pointer = [=](const events::StreamSession &session, const INPUT_PKT &pkt) {
+    if (cooperative_pointer_lease.count() == 0 || !is_pointer_packet(pkt.type)) {
+      return true;
+    }
+
+    auto lobby = state::get_lobby_by_connected_session(
+        lobbies->load().get(), std::to_string(session.session_id));
+    if (!lobby || !lobby->multi_user || lobby->connected_sessions->load()->size() < 2) {
+      return true;
+    }
+
+    const auto now = std::chrono::steady_clock::now();
+    const auto expires_at = now + cooperative_pointer_lease;
+    std::scoped_lock lock(*pointer_lease_mutex);
+    auto current = pointer_leases->find(lobby->id);
+    const bool owns_lease = current != pointer_leases->end() &&
+                            current->second.owner_session_id == session.session_id;
+    const bool lease_expired = current == pointer_leases->end() || current->second.expires_at <= now;
+    const bool active_drag = current != pointer_leases->end() && !current->second.pressed_buttons.empty();
+
+    // A deliberate click or scroll takes control immediately, except while
+    // another client has a button held. Keeping ownership through the release
+    // makes cooperative drags atomic and avoids cross-client button state.
+    const bool explicit_takeover = pkt.type == MOUSE_BUTTON_PRESS ||
+                                   pkt.type == MOUSE_SCROLL ||
+                                   pkt.type == MOUSE_HSCROLL;
+    if (owns_lease) {
+      if (pkt.type == MOUSE_BUTTON_PRESS) {
+        current->second.pressed_buttons.insert(static_cast<const MOUSE_BUTTON_PACKET &>(pkt).button);
+      } else if (pkt.type == MOUSE_BUTTON_RELEASE) {
+        current->second.pressed_buttons.erase(static_cast<const MOUSE_BUTTON_PACKET &>(pkt).button);
+      }
+      current->second.expires_at = expires_at;
+      return true;
+    }
+    if (active_drag || pkt.type == MOUSE_BUTTON_RELEASE) {
+      return false;
+    }
+    if (!lease_expired && !explicit_takeover) {
+      return false;
+    }
+
+    PointerLease next{session.session_id, expires_at, {}};
+    if (pkt.type == MOUSE_BUTTON_PRESS) {
+      next.pressed_buttons.insert(static_cast<const MOUSE_BUTTON_PACKET &>(pkt).button);
+    }
+    if (current == pointer_leases->end()) {
+      pointer_leases->emplace(lobby->id, std::move(next));
+    } else {
+      current->second = std::move(next);
+    }
+    logs::log(logs::debug,
+              "[INPUT] Cooperative lobby {} pointer lease moved to session {}",
+              lobby->id,
+              session.session_id);
+    return true;
+  };
+
+  auto relinquish_pointer_lease = [=](const events::StreamSession &session) {
+    auto lobby = state::get_lobby_by_connected_session(
+        lobbies->load().get(), std::to_string(session.session_id));
+    if (!lobby) {
+      return;
+    }
+    std::scoped_lock lock(*pointer_lease_mutex);
+    auto current = pointer_leases->find(lobby->id);
+    if (current != pointer_leases->end() && current->second.owner_session_id == session.session_id) {
+      pointer_leases->erase(current);
+    }
+  };
+
