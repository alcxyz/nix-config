+static std::string readAudioReopenToken()
+{
+    const char* runtimeDir = SDL_getenv("XDG_RUNTIME_DIR");
+    if (runtimeDir == nullptr) {
+        return {};
+    }
+
+    std::ifstream marker(std::string(runtimeDir) + "/moonlight-audio-reopen");
+    std::string token;
+    std::getline(marker, token);
+    return token;
+}
+
+static bool s_AudioReopenTokenInitialized = false;
+static std::string s_AudioReopenToken;
