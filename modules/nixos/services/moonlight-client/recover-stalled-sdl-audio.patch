+    // leave SDL running with timing inherited from the old sink. Recreate only
+    // the audio renderer when the route helper advances its generation marker.
+    Uint32 now = SDL_GetTicks();
+    if (now - s_LastAudioReopenCheck >= 250) {
+        s_LastAudioReopenCheck = now;
