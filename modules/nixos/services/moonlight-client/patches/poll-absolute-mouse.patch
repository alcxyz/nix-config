+void SdlInputHandler::pollAbsoluteMousePosition()
+{
+    if (!m_AbsoluteMouseMode || !isCaptureActive() || m_Window == nullptr) {
+        m_HavePolledMousePosition = false;
+        return;
+    }
+
+    int globalX, globalY;
+    SDL_GetGlobalMouseState(&globalX, &globalY);
+
+    if (m_HavePolledMousePosition &&
+            globalX == m_LastPolledMouseX && globalY == m_LastPolledMouseY) {
+        return;
+    }
+
+    int windowX, windowY;
+    SDL_GetWindowPosition(m_Window, &windowX, &windowY);
+
+    SDL_MouseMotionEvent event = {};
+    event.type = SDL_MOUSEMOTION;
+    event.timestamp = SDL_GetTicks();
+    event.windowID = SDL_GetWindowID(m_Window);
+    event.which = 0;
+    event.x = globalX - windowX;
+    event.y = globalY - windowY;
+    if (m_HavePolledMousePosition) {
+        event.xrel = globalX - m_LastPolledMouseX;
+        event.yrel = globalY - m_LastPolledMouseY;
+    }
+
+    m_HavePolledMousePosition = true;
+    m_LastPolledMouseX = globalX;
+    m_LastPolledMouseY = globalY;
+    handleMouseMotionEvent(&event);
+}
